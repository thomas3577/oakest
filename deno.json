{
  "name": "@dx/oakest",
  "version": "0.1.0-alpha.2",
  "exports": {
    ".": "./mod.ts"
  },
  "tasks": {
    "demo": "deno run -A ./demo/main.ts",
    "update": "deno outdated --update --latest"
  },
  "imports": {
    "@needle-di/core": "jsr:@needle-di/core@1.2.0",
    "@oak/oak": "jsr:@oak/oak@17.2.0",
    "@std/log": "jsr:@std/log@0.224.14",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "publish": {
    "exclude": [
      ".github",
      ".vscode",
      "demo",
      ".gitignore",
      ".editorconfig",
      "deno.lock",
      "**/*.test.ts"
    ]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 360,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      ".vscode/**"
    ]
  }
}
