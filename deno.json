{
  "name": "@dx/oakest",
  "version": "0.0.30",
  "exports": {
    ".": "./mod.ts",
    "./tools/generate-di-registry": "./tools/generate-di-registry.ts"
  },
  "tasks": {
    "demo": "deno task generate:di:demo && deno run -A ./demo/main.ts",
    "generate:di": "deno run -A ./tools/generate-di-registry.ts --root . --out ./oakest.di.generated.ts --import-source @dx/oakest",
    "generate:di:demo": "deno run -A ./tools/generate-di-registry.ts --root ./demo --out ./demo/oakest.di.generated.ts --import-source ../mod.ts",
    "lock": "deno cache **/*.*.ts",
    "update": "deno outdated --update --latest"
  },
  "imports": {
    "@needle-di/core": "jsr:@needle-di/core@1.1.2",
    "@oak/oak": "jsr:@oak/oak@17.2.0",
    "@std/path": "jsr:@std/path@1.1.4",
    "@std/log": "jsr:@std/log@0.224.14",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "publish": {
    "exclude": [
      ".github",
      ".vscode",
      "demo",
      ".gitignore",
      ".editorconfig",
      "deno.lock",
      "**/*.test.ts"
    ]
  },
  "compilerOptions": {
    "experimentalDecorators": true
  },
  "lint": {
    "rules": {
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 360,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": [
      ".vscode/**"
    ]
  }
}
